<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FAKE.Core.Target" Version="6.1.4" />
    <PackageReference Include="FAKE.DotNet.Cli" Version="6.1.4" />
    <!-- FAKE 6.1.4 allows these direct patched overrides of its older transitive packages. -->
    <PackageReference Include="NuGet.Packaging" Version="6.14.3" />
    <PackageReference Include="NuGet.Protocol" Version="6.14.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>
</Project>
